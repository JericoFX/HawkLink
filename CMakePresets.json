{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 MSVC",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "BUILD_TESTING": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-msvc-asan",
      "displayName": "Windows x64 MSVC AddressSanitizer",
      "inherits": "windows-msvc",
      "binaryDir": "${sourceDir}/build/windows-msvc-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS": "/DWIN32 /D_WINDOWS /fsanitize=address",
        "CMAKE_CXX_FLAGS": "/DWIN32 /D_WINDOWS /EHsc /fsanitize=address",
        "CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO": "/debug /INCREMENTAL:NO"
      }
    },
    {
      "name": "windows-clang-asan",
      "displayName": "Windows x64 LLVM AddressSanitizer",
      "inherits": "windows-msvc-asan",
      "binaryDir": "${sourceDir}/build/windows-clang-asan",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "${sourceDir}/implementation/tools/llvm-23.1.3/portable/clang+llvm-23.1.3-x86_64-pc-windows-msvc/bin/clang-cl.exe",
        "CMAKE_CXX_COMPILER": "${sourceDir}/implementation/tools/llvm-23.1.3/portable/clang+llvm-23.1.3-x86_64-pc-windows-msvc/bin/clang-cl.exe",
        "CMAKE_LINKER": "${sourceDir}/implementation/tools/llvm-23.1.3/portable/clang+llvm-23.1.3-x86_64-pc-windows-msvc/bin/lld-link.exe",
        "CMAKE_TRY_COMPILE_CONFIGURATION": "RelWithDebInfo",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO": "/debug /INCREMENTAL:NO /libpath:\"${sourceDir}/implementation/tools/llvm-23.1.3/portable/clang+llvm-23.1.3-x86_64-pc-windows-msvc/lib/clang/23/lib/windows\""
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux GCC",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-gcc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "ON" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc", "configurePreset": "windows-msvc" },
    { "name": "windows-msvc-asan", "configurePreset": "windows-msvc-asan" },
    { "name": "windows-clang-asan", "configurePreset": "windows-clang-asan" },
    { "name": "linux-gcc", "configurePreset": "linux-gcc" }
  ],
  "testPresets": [
    { "name": "windows-msvc", "configurePreset": "windows-msvc", "output": { "outputOnFailure": true } },
    {
      "name": "windows-msvc-asan",
      "configurePreset": "windows-msvc-asan",
      "environment": { "ASAN_OPTIONS": "alloc_dealloc_mismatch=1" },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-clang-asan",
      "configurePreset": "windows-clang-asan",
      "environment": {
        "ASAN_OPTIONS": "alloc_dealloc_mismatch=1",
        "ASAN_SYMBOLIZER_PATH": "${sourceDir}/implementation/tools/llvm-23.1.3/portable/clang+llvm-23.1.3-x86_64-pc-windows-msvc/bin/llvm-symbolizer.exe",
        "PATH": "${sourceDir}/implementation/tools/llvm-23.1.3/portable/clang+llvm-23.1.3-x86_64-pc-windows-msvc/lib/clang/23/lib/windows;$penv{PATH}"
      },
      "output": { "outputOnFailure": true }
    },
    { "name": "linux-gcc", "configurePreset": "linux-gcc", "output": { "outputOnFailure": true } }
  ]
}
